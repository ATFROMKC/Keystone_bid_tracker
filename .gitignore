__pycache__/
*.py[cod]

# Cursor: ignore local workspace data; keep shared rules tracked
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Local app/runtime configuration
keystone_bid_tracker/config.json

# Accidental nested-repo path
keystone_bid_tracker/Keystone_bid_tracker/

# Personal/local reference files (kept out of source control)
_local/*
!_local/.gitkeep
!_local/README.md

# Local archives and generated build outputs
_archive/
build/
dist/

# Local packaged zips (large; share via drive/release, not git)
packages/*.zip

# Packaging artifacts
*.spec
*.exe
*.pkg
*.pyz
*.toc
base_library.zip
